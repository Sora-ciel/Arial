rules_version = '2';

// Attachments — images, video and any block field too large to sit in the
// database — are written to users/{uid}/attachments/... and nowhere else.
//
// These rules had no file in the repo, which meant whatever was configured in
// the console was the only thing standing between one account's attachments
// and another's. Everything is denied by default here, and each account is
// confined to its own prefix.
//
// Note that files already handed out as download URLs stay reachable through
// those URLs: a Firebase download token grants access on its own and is not
// subject to these rules. Restricting reads here stops one account browsing
// another's storage; it does not revoke a link that has already been shared.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A ceiling so a compromised or scripted client can't park unbounded data
    // in the bucket. Comfortably above the 100MB limit the app itself enforces
    // on video. This bounds one upload; storageFull below bounds the total.
    function withinSizeLimit() {
      return request.resource.size < 120 * 1024 * 1024;
    }

    // Set as a custom claim by trackStorageUpload in functions/index.js once
    // an account's stored bytes pass its plan's limit, and cleared again when
    // deletes bring it back under. These rules cannot read the running total
    // themselves — Storage rules can query Firestore but not the Realtime
    // Database, where the counter lives — so the answer is carried on the
    // user's own token instead.
    //
    // The claim is absent rather than false when an account is under its
    // limit, so this must read as true for a token that has never carried it.
    //
    // The membership check is not defensive padding, it is the whole thing:
    // reading a claim that is not present throws (`Property storageFull is
    // undefined on object`) rather than returning null, and a rule that
    // throws denies. Written as a bare `token.storageFull != true` this
    // clause rejects every upload from every account under its limit — which
    // is all of them.
    function notOverQuota() {
      return !('storageFull' in request.auth.token)
        || request.auth.token.storageFull != true;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);

      // `create, update` rather than `write`, because `write` also covers
      // delete — where request.resource is null and the size check would throw.
      allow create, update: if isOwner(uid) && withinSizeLimit() && notOverQuota();

      // Deliberately not subject to notOverQuota. Deleting is the only way out
      // of a full account, and gating it behind the quota would leave someone
      // who filled their storage permanently unable to empty it.
      allow delete: if isOwner(uid);
    }

    // Anything outside a user's own prefix is denied, including paths this
    // app doesn't use today.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
